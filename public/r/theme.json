{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "Main Brand theme",
  "description": "Semantic + Button tokens from the Main Brand Figma file (light/dark), fonts, radii and the `selected` variant.",
  "cssVars": {
    "theme": {
      "color-background": "var(--background)",
      "color-foreground": "var(--foreground)",
      "color-card": "var(--card)",
      "color-card-foreground": "var(--card-foreground)",
      "color-popover": "var(--popover)",
      "color-popover-foreground": "var(--popover-foreground)",
      "color-primary": "var(--primary)",
      "color-primary-foreground": "var(--primary-foreground)",
      "color-secondary": "var(--secondary)",
      "color-secondary-foreground": "var(--secondary-foreground)",
      "color-muted": "var(--muted)",
      "color-muted-foreground": "var(--muted-foreground)",
      "color-accent": "var(--accent)",
      "color-accent-foreground": "var(--accent-foreground)",
      "color-destructive": "var(--destructive)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "color-border": "var(--border)",
      "color-input": "var(--input)",
      "color-ring": "var(--ring)",
      "radius-sm": "calc(var(--radius) - 4px)",
      "radius-md": "var(--radius)",
      "radius-lg": "var(--radius)",
      "radius-xl": "var(--radius-soft)",
      "font-sans": "var(--font-dm-sans, \"DM Sans\"), ui-sans-serif, system-ui, sans-serif",
      "font-heading": "var(--font-manrope, \"Manrope\"), var(--font-dm-sans, \"DM Sans\"), sans-serif",
      "font-button": "var(--font-inter, \"Inter\"), ui-sans-serif, system-ui, sans-serif",
      "font-mono": "var(--font-roboto-mono, \"Roboto Mono\"), ui-monospace, monospace"
    },
    "light": {
      "brand-primary": "#ff4800",
      "brand-primary-hover": "#d43b00",
      "brand-primary-pressed": "#b83200",
      "brand-on-primary": "#150a07",
      "brand-on-primary-active": "#ffffff",
      "brand-strong": "#b83200",
      "brand-subtle": "#fff4ed",
      "brand-strong-hover": "#8f2900",
      "brand-strong-pressed": "#702100",
      "text-primary": "#1c1c1c",
      "surface": "#f5f5f5",
      "surface-elevated": "#ffffff",
      "surface-hover": "#eeeeee",
      "muted-background": "#f5f5f5",
      "status-error-text": "#991b1b",
      "status-error-background": "#fef2f2",
      "border-disabled": "#d4d4d4",
      "background": "#ffffff",
      "foreground": "var(--text-primary)",
      "card": "var(--surface-elevated)",
      "card-foreground": "var(--text-primary)",
      "popover": "var(--surface-elevated)",
      "popover-foreground": "var(--text-primary)",
      "primary": "var(--brand-primary)",
      "primary-foreground": "var(--brand-on-primary)",
      "secondary": "var(--surface)",
      "secondary-foreground": "var(--text-primary)",
      "muted": "var(--muted-background)",
      "muted-foreground": "#666666",
      "accent": "var(--surface-hover)",
      "accent-foreground": "var(--text-primary)",
      "destructive": "#b91c1c",
      "destructive-foreground": "#ffffff",
      "border": "#d4d4d4",
      "input": "#767676",
      "ring": "var(--brand-strong)",
      "radius": "8px",
      "radius-soft": "16px",
      "stroke": "1px",
      "effect-outer": "rgb(0 0 0 / 0.08)",
      "effect-pressed-inner": "rgb(0 0 0 / 0.04)",
      "text-secondary": "#525252",
      "icon-secondary": "#525252",
      "input-surface": "#ffffff",
      "input-text": "#1c1c1c",
      "input-placeholder": "#666666",
      "input-outline": "#929292",
      "input-outline-hover": "#767676",
      "input-outline-focus": "var(--brand-primary)",
      "input-surface-disabled": "#f5f5f5",
      "border-control": "#767676",
      "disabled-border": "#d4d4d4",
      "disabled-background": "#e5e5e5",
      "disabled-text": "#858585",
      "selected-background": "#e5e5e5",
      "radius-input-pill": "9999px",
      "radius-input-multiline": "24px",
      "status-error-border": "#b91c1c",
      "status-error-icon": "#b91c1c",
      "status-warning-border": "#a16207",
      "status-warning-icon": "#a16207",
      "status-warning-text": "#854d0e",
      "status-success-border": "#15803d",
      "status-success-icon": "#15803d",
      "status-success-text": "#166534",
      "status-info-icon": "#1d4ed8",
      "status-info-text": "#1e40af",
      "status-info-border": "#1d4ed8",
      "status-info-background": "#eff6ff",
      "status-success-background": "#f0fdf4",
      "status-warning-background": "#fffbeb",
      "skeleton": "#e5e5e5",
      "surface-pressed": "#e5e5e5",
      "border-subtle": "#d4d4d4",
      "overlay": "rgb(0 0 0 / 0.64)",
      "tooltip-background": "#111111",
      "tooltip-text": "#f5f5f5",
      "button-focus-color": "var(--brand-strong)",
      "button-disabled-background": "#e5e5e5",
      "button-disabled-text": "#858585",
      "button-primary-default-background": "var(--brand-primary)",
      "button-primary-hover-background": "var(--brand-primary-hover)",
      "button-primary-pressed-background": "var(--brand-primary-pressed)",
      "button-primary-selected-background": "var(--brand-primary-hover)",
      "button-primary-default-text": "var(--brand-on-primary)",
      "button-primary-active-text": "var(--brand-on-primary-active)",
      "button-neutral-text": "#000000",
      "button-selected-text": "var(--brand-strong)",
      "button-secondary-default-background": "#f5f5f5",
      "button-secondary-default-border": "#d4d4d4",
      "button-secondary-hover-background": "#eeeeee",
      "button-secondary-pressed-background": "#e5e5e5",
      "button-secondary-selected-background": "var(--brand-subtle)",
      "button-secondary-selected-border": "var(--brand-strong)",
      "button-outline-default-border": "#767676",
      "button-outline-hover-border": "#525252",
      "button-outline-pressed-border": "#000000",
      "button-ghost-hover-background": "#f5f5f5",
      "button-ghost-pressed-background": "#e5e5e5",
      "button-ghost-selected-background": "var(--brand-subtle)",
      "button-ghost-selected-border": "var(--brand-strong)",
      "button-destructive-default-background": "#fef2f2",
      "button-destructive-default-border": "#b91c1c",
      "button-destructive-default-text": "#991b1b",
      "button-destructive-hover-background": "#b91c1c",
      "button-destructive-pressed-background": "#991b1b",
      "button-destructive-selected-background": "#b91c1c",
      "button-destructive-active-text": "#ffffff",
      "button-link-default-text": "var(--brand-strong)",
      "button-link-hover-text": "var(--brand-strong-hover)",
      "button-link-pressed-text": "var(--brand-strong-pressed)",
      "button-link-selected-text": "var(--brand-strong)"
    },
    "dark": {
      "text-primary": "#f5f5f5",
      "surface": "#1c1c1c",
      "surface-elevated": "#262626",
      "surface-hover": "#333333",
      "muted-background": "#262626",
      "status-error-text": "#fecaca",
      "status-error-background": "#450a0a",
      "border-disabled": "#404040",
      "background": "#111111",
      "foreground": "var(--text-primary)",
      "card": "var(--surface-elevated)",
      "card-foreground": "var(--text-primary)",
      "popover": "var(--surface-elevated)",
      "popover-foreground": "var(--text-primary)",
      "secondary": "var(--surface)",
      "secondary-foreground": "var(--text-primary)",
      "muted": "var(--muted-background)",
      "accent": "var(--surface-hover)",
      "accent-foreground": "var(--text-primary)",
      "muted-foreground": "#a3a3a3",
      "destructive": "#dc2626",
      "border": "#404040",
      "input": "#8a8a8a",
      "brand-strong": "#ff753d",
      "brand-subtle": "#2a1206",
      "brand-strong-hover": "#ff9a6e",
      "brand-strong-pressed": "#ffbfa3",
      "ring": "var(--brand-strong)",
      "effect-outer": "rgb(0 0 0 / 0.4)",
      "effect-pressed-inner": "rgb(0 0 0 / 0.3)",
      "text-secondary": "#b0b0b0",
      "icon-secondary": "#b0b0b0",
      "input-surface": "#1c1c1c",
      "input-text": "#f5f5f5",
      "input-placeholder": "#a3a3a3",
      "input-outline": "#707070",
      "input-outline-hover": "#8a8a8a",
      "input-surface-disabled": "#262626",
      "border-control": "#8a8a8a",
      "disabled-border": "#404040",
      "disabled-background": "#333333",
      "selected-background": "#333333",
      "status-error-border": "#f87171",
      "status-error-icon": "#f87171",
      "status-warning-border": "#facc15",
      "status-warning-icon": "#facc15",
      "status-warning-text": "#fde68a",
      "status-success-border": "#4ade80",
      "status-success-icon": "#4ade80",
      "status-success-text": "#bbf7d0",
      "status-info-icon": "#60a5fa",
      "status-info-text": "#bfdbfe",
      "status-info-border": "#60a5fa",
      "status-info-background": "#172554",
      "status-success-background": "#052e16",
      "status-warning-background": "#422006",
      "skeleton": "#333333",
      "surface-pressed": "#333333",
      "border-subtle": "#404040",
      "tooltip-background": "#f5f5f5",
      "tooltip-text": "#000000",
      "button-focus-color": "var(--brand-strong)",
      "button-disabled-background": "#262626",
      "button-disabled-text": "#6b6b6b",
      "button-neutral-text": "#f5f5f5",
      "button-selected-text": "var(--brand-strong)",
      "button-secondary-default-background": "#1c1c1c",
      "button-secondary-default-border": "#404040",
      "button-secondary-hover-background": "#333333",
      "button-secondary-pressed-background": "#262626",
      "button-secondary-selected-background": "var(--brand-subtle)",
      "button-secondary-selected-border": "var(--brand-strong)",
      "button-outline-default-border": "#8a8a8a",
      "button-outline-hover-border": "#a3a3a3",
      "button-outline-pressed-border": "#f5f5f5",
      "button-ghost-hover-background": "#262626",
      "button-ghost-pressed-background": "#333333",
      "button-ghost-selected-background": "var(--brand-subtle)",
      "button-ghost-selected-border": "var(--brand-strong)",
      "button-destructive-default-background": "#450a0a",
      "button-destructive-default-border": "#f87171",
      "button-destructive-default-text": "#fecaca",
      "button-link-default-text": "var(--brand-strong)",
      "button-link-hover-text": "var(--brand-strong-hover)",
      "button-link-pressed-text": "var(--brand-strong-pressed)",
      "button-link-selected-text": "var(--brand-strong)"
    }
  },
  "css": {
    "@custom-variant selected (&:is([aria-pressed=\"true\"], [aria-current=\"page\"], [data-state=\"on\"]):not(:disabled, [aria-disabled=\"true\"]))": {},
    "@keyframes progress-indeterminate": {
      "0%": {
        "transform": "translateX(-100%)"
      },
      "100%": {
        "transform": "translateX(300%)"
      }
    }
  },
  "type": "registry:theme"
}